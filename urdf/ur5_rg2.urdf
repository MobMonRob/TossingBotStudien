  <link name="wrist_3_link">
    <visual name="wrist_3_link_visual">
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/visual/ur5/wrist3.dae"/></geometry>
    </visual>
    <collision name="wrist_3_link_collision">
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/collision/ur5/wrist3.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1879"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.089159" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="150.0" velocity="3.15"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.13585 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="150.0" velocity="3.15"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.1197 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="150.0" velocity="3.15"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.39225" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="28.0" velocity="3.2"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.093 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="28.0" velocity="3.2"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.09465" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="28.0" velocity="3.2"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <joint name="ur5_hand_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="rg2_hand"/>
    <origin xyz="0 0.0823 0" rpy="1.570796325 0 1.570796325"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <link name="rg2_hand">
    <visual name="rg2_hand_visual">
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/visual/rg2/hand.dae"/></geometry>
    </visual>
    <collision name="rg2_hand_collision">
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/collision/rg2/hand.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <link name="rg2_leftfinger">
    <visual>
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/visual/rg2/finger.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/collision/rg2/finger.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="rg2_rightfinger">
    <visual>
      <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/visual/rg2/finger.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://ur5_rg2_ign/ur5_rg2/meshes/collision/rg2/finger.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="rg2_finger_joint1" type="revolute">
  <parent link="rg2_hand"/>
  <child link="rg2_leftfinger"/>
  <origin rpy="0 0 0" xyz="0.105 0.017 0"/>
  <axis xyz="0 1 0"/>
  <limit effort="10.6" lower="-0.5" upper="0.5" velocity="1.57"/>
  <dynamics damping="5.0" friction="1.0"/>
</joint>

<joint name="rg2_finger_joint2" type="revolute">
  <parent link="rg2_hand"/>
  <child link="rg2_rightfinger"/>
  <origin rpy="0 0 0" xyz="0.105 -0.017 0"/>
  <axis xyz="0 -1 0"/>
  <limit effort="10.6" lower="-0.5" upper="0.5" velocity="1.57"/>
  <mimic joint="rg2_finger_joint1" multiplier="1.0" offset="0.0"/>
  <dynamics damping="5.0" friction="1.0"/>
</joint>

  <link name="tool0">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="end_effector_frame_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0.275 0" rpy="-1.570796325 0 0"/>
  </joint>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>/home/s/tossingbot_ws/install/ur5_rg2_ign/share/ur5_rg2_ign/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="mimic_plugin" filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so">
      <joint>rg2_finger_joint1</joint>
      <mimicJoint>rg2_finger_joint2</mimicJoint>
      <multiplier>1.0</multiplier>
      <offset>0.0</offset>
      <maxEffort>100.0</maxEffort>
      <sensitiveness>0.0</sensitiveness>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <selfCollide>false</selfCollide>
    <gravity>true</gravity>
    <maxContacts>10</maxContacts>
  </gazebo>

  <gazebo reference="shoulder_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="upper_arm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="forearm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="wrist_1_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="wrist_2_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="wrist_3_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="rg2_hand"><material>Gazebo/Grey</material></gazebo>

  <gazebo reference="rg2_leftfinger">
    <material>Gazebo/Grey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_rightfinger">
    <material>Gazebo/Grey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_finger_joint1">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
    <fudgeFactor>1.0</fudgeFactor>
  </gazebo>

  <gazebo reference="rg2_finger_joint2">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
    <fudgeFactor>1.0</fudgeFactor>
  </gazebo>

  <gazebo reference="shoulder_pan_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
  </gazebo>

  <gazebo reference="shoulder_lift_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
  </gazebo>

  <gazebo reference="elbow_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
  </gazebo>

  <gazebo reference="wrist_1_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
  </gazebo>

  <gazebo reference="wrist_2_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
  </gazebo>

  <gazebo reference="wrist_3_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
    <stopCfm>0.001</stopCfm>
    <stopErp>0.8</stopErp>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rg2_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rg2_finger_joint2">
      <param name="mimic">rg2_finger_joint1</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
