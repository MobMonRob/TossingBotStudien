      <mass value="1.219"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0025598989760" ixy="0.0" ixz="0.0" iyy="0.0025598989760" iyz="0.0" izz="0.0021942"/>
    </inertial>
